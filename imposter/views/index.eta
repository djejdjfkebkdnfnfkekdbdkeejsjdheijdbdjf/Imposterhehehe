    <hr>

    <form method='post'>
        <p><label>Ord: <input name='word'></label></p>
        <p><button name='insert'>Infoga (ange ord)</button></p>
        <p><button name='remove'>Ta bort (ange ord)</button></p>
    </form>
    <form method='post'>
        <p><label>Antal spelare: <input name="spelare" type="number"></label></p>
        <p><button name="spela">Starta spelet (Ange antal spelare)</button></p>
    </form>
</body>

</html>