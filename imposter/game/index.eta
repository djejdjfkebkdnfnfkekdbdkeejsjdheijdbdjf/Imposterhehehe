<!DOCTYPE html>
<html lang="sv">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ord</title>

    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <h1>Ord</h1>
    
    <button onclick="VisaOrd()">Visa Ordet</button>
    <button onclick="GömOrd()">Göm Ordet</button>
    <p id="demo"></p>
    <br>
    <br>
    <button onclick="NästaSpelare()">Nästa Spelare</button>
    <button onclick="Startaspelet()">Starta spelet</button>

    <p>Aktiva spelaren är:</p>
    <p id="aktivspelare">1 </p>
    <hr>
    <h2 id="vemstartar1"></h2>
    <script>
        let börjande = Math.floor(Math.random() * <%= data.players%>) + 1
        let aktivspelare = 1
        const spelarord = [];
        
        <% for (let i = 0; i < data.spelarord.length; i++) { %>
            spelarord[<%= i %>] = "<%= data.spelarord[i][1] %>"
            <% } %>

                    function VisaOrd() {

                        document.getElementById("demo").innerHTML = "hemliga ordet är: " + spelarord[aktivspelare - 1];

                    }
        function GömOrd() {
            document.getElementById("demo").innerHTML = "";
        }
        function NästaSpelare() {
            aktivspelare = aktivspelare + 1
            document.getElementById("aktivspelare").innerHTML = aktivspelare;
        }
        function Startaspelet() {
            document.getElementById("vemstartar1").innerHTML = "Spelaren som börjar är spelare nr:  " + börjande  ;

        }
    </script>


    <hr>


</body>

</html>