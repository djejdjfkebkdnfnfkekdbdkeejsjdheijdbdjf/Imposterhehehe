<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ord</title>

    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <h1>Ord</h1>


    <!-- <table>
        <tr>
            <th>id</th>
            <th>name</th>
